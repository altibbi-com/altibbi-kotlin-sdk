<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context="com.altibbi.kotlinsdk.consultation.AiSupportActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/design_screen_padding">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Altibbi.AppCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:paddingBottom="8dp"
                        android:text="AI Support"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/light_gray" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Consultation ID">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_ai_consultation_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fetch_all_ai"
                        style="@style/Widget.Altibbi.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/design_button_height"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="@dimen/design_button_spacing"
                        android:text="Fetch All AI Results" />

                    <TextView
                        android:id="@+id/tv_ai_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:padding="10dp"
                        android:textAlignment="center"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fetch_transcription"
                        style="@style/Widget.Altibbi.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/design_button_height"
                        android:layout_marginBottom="8dp"
                        android:text="Get Transcription" />

                    <TextView
                        android:id="@+id/tv_transcription_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@color/light_gray"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fetch_soap"
                        style="@style/Widget.Altibbi.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/design_button_height"
                        android:layout_marginBottom="8dp"
                        android:text="Get SOAP Summary" />

                    <TextView
                        android:id="@+id/tv_soap_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@color/light_gray"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fetch_predict_summary"
                        style="@style/Widget.Altibbi.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/design_button_height"
                        android:layout_marginBottom="8dp"
                        android:text="Get Predict Summary" />

                    <TextView
                        android:id="@+id/tv_predict_summary_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@color/light_gray"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fetch_predict_specialty"
                        style="@style/Widget.Altibbi.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/design_button_height"
                        android:layout_marginBottom="8dp"
                        android:text="Get Predict Specialty" />

                    <TextView
                        android:id="@+id/tv_predict_specialty_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/light_gray"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
